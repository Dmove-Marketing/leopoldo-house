---
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import WhatsAppWidget from '../components/ui/WhatsAppWidget.astro';
import InteractionTrigger from '../components/tracking/InteractionTrigger.astro';
import '../styles/eventos-corporativos-v2.css';

const webhookUrl = config.forms['lead-form'].webhooks[0];
const projectSlug = config.project_slug;
const waPhone = (config as any).whatsapp_popup?.phone || '5511974060363';
---

<Base
  title="Leopoldo House — Eventos Corporativos no Itaim Bibi"
  description="Espaço para eventos corporativos no Itaim Bibi, São Paulo. Sofisticação, estrutura e alta gastronomia para fortalecer relacionamentos e valorizar sua marca."
  ogImage="/images/og-index.jpg"
  noWhatsappPopup={true}
>

<!-- HEADER -->
<header class="site-header">
  <div class="wrap">
    <a href="#topo" class="logo">Leopoldo House</a>
  </div>
</header>

<!-- HERO -->
<section id="topo">
  <div class="midia-fundo">
    <Img src="hero-corporativo.jpg" alt="Salão do Leopoldo House montado para evento corporativo" priority width={1920} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
  </div>
  <div class="wrap hero-conteudo">
    <h1><span class="peso-book">Faça seu<br class="quebra-mobile"> evento corporativo</span><br><span class="peso-bold">em um espaço<br class="quebra-mobile"> que comunica</span><br><span class="peso-bold">o valor da<br class="quebra-mobile"> sua marca.</span></h1>
    <div class="hero-acao">
      <a href="#contato" class="btn btn-claro">Solicite um orçamento <span class="seta-btn">→</span></a>
    </div>
  </div>
</section>

<!-- O ESPAÇO -->
<section id="sobre">
  <div class="wrap">
    <div class="sobre-intro">
      <p class="rotulo">O Espaço</p>
      <h2><span class="peso-book">Seu evento diz muito</span><br><span class="peso-bold">sobre a sua marca.</span></h2>
      <p class="texto-sobre">Do briefing à execução,<br class="quebra-mobile"> uma estrutura preparada para<br>transformar objetivos em experiências memoráveis.</p>
    </div>

    <div class="carrossel-espaco">
      <button type="button" class="carrossel-seta carrossel-seta--prev" data-alvo="trilho-espaco" data-direcao="-1" aria-label="Foto anterior">←</button>
      <div class="carrossel-trilho" id="trilho-espaco">
        <div class="carrossel-item"><Img src="sobre-corporativo-01.jpg" alt="Ambiente do Leopoldo House montado para evento corporativo" width={800} /></div>
        <div class="carrossel-item"><Img src="sobre-corporativo-02.jpg" alt="Detalhe da montagem de evento corporativo no Leopoldo House" width={800} /></div>
        <div class="carrossel-item"><Img src="espaco-01.jpg" alt="Ambiente do Leopoldo House — foto 1" width={800} /></div>
        <div class="carrossel-item"><Img src="espaco-02.jpg" alt="Ambiente do Leopoldo House — foto 2" width={800} /></div>
        <div class="carrossel-item"><Img src="espaco-03.jpg" alt="Ambiente do Leopoldo House — foto 3" width={800} /></div>
        <div class="carrossel-item"><Img src="espaco-04.jpg" alt="Ambiente do Leopoldo House — foto 4" width={800} /></div>
        <div class="carrossel-item"><Img src="espaco-05.jpg" alt="Ambiente do Leopoldo House — foto 5" width={800} /></div>
        <div class="carrossel-item"><Img src="espaco-06.jpg" alt="Ambiente do Leopoldo House — foto 6" width={800} /></div>
      </div>
      <button type="button" class="carrossel-seta carrossel-seta--next" data-alvo="trilho-espaco" data-direcao="1" aria-label="Próxima foto">→</button>
    </div>
    <div class="carrossel-dots" data-alvo="trilho-espaco"></div>
  </div>
</section>

<!-- VERSATILIDADE -->
<section id="versatilidade">
  <div class="wrap">
    <div>
      <p class="rotulo">Versatilidade</p>
      <h2><span class="peso-book">Diversas possibilidades.</span><br><span class="peso-bold">O mesmo padrão<br class="quebra-mobile"> de excelência.</span></h2>
      <p class="texto-versatilidade">Com 7 metros de pé-direito<br class="quebra-mobile"> e 450m² de área total,<br>o espaço se adapta a<br class="quebra-mobile"> qualquer formato de evento,<br>recebendo até 400 convidados em coquetel,<br class="esconde-mobile"> 250 em jantar<br class="quebra-mobile"> ou 130 em plenária.</p>

      <div class="pills">
        <span class="pill"><svg class="pill-icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16l-8 8z"/><path d="M12 12v6"/><path d="M8.5 20h7"/></svg>Coquetéis</span>
        <span class="pill"><svg class="pill-icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="4.5" width="17" height="11" rx="1"/><path d="M8 9.5l3-2 2.5 1.8L18 6.5"/><path d="M12 15.5v4"/><path d="M9 19.5h6"/></svg>Plenárias</span>
        <span class="pill"><svg class="pill-icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 21h4"/><path d="M12 3a6 6 0 0 0-3 11.2c.6.5 1 1.3 1 2.1v.2h4v-.2c0-.8.4-1.6 1-2.1A6 6 0 0 0 12 3z"/></svg>Workshops</span>
        <div class="quebra-pills"></div>
        <span class="pill"><svg class="pill-icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="8.5" cy="8" r="2.5"/><circle cx="16" cy="9" r="2.2"/><path d="M3.5 19c0-3 2.2-5.2 5-5.2s5 2.2 5 5.2"/><path d="M13.8 14.3c2.2.3 4 2.3 4.2 4.7"/></svg>Convenções</span>
        <span class="pill"><svg class="pill-icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6 2.5 11 12 16l9.5-5z"/><path d="M6 13.5v4.3c0 1.4 2.7 2.7 6 2.7s6-1.3 6-2.7v-4.3"/><path d="M21.5 11v5"/></svg>Treinamentos</span>
        <span class="pill"><svg class="pill-icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3v5.5"/><path d="M7.5 3v5.5"/><path d="M10 3v5.5"/><path d="M7.5 8.5v12.5"/><path d="M17 3c2.1.4 3.1 2.6 2.6 5.1-.3 2.1-1.6 3.7-2.6 4.2v8.7"/></svg>Jantares</span>
        <span class="pill"><svg class="pill-icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M11 3l1.4 4 4 1.4-4 1.4L11 14l-1.4-4.2L5.6 8.4l4-1.4z"/><path d="M18 13.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z"/></svg>Confraternizações</span>
      </div>
    </div>
  </div>
</section>

<!-- ESTRUTURA -->
<section id="estrutura">
  <div class="wrap">
    <div class="cabecalho-secao">
      <p class="rotulo">Estrutura</p>
      <h2><span class="peso-bold">Uma estrutura<br class="quebra-mobile"> que impressiona</span><br class="quebra-mobile"><span class="peso-book"> já no primeiro<br class="quebra-mobile"> contato.</span></h2>
      <p class="subtexto">Conheça nossos ambientes.</p>
    </div>

    <div class="grid-estrutura">
      <article class="card">
        <Img src="estrutura-salao.jpg" alt="Salão amplo do Leopoldo House com pé-direito alto" width={700} style="width:100%;aspect-ratio:4/5;object-fit:cover" />
        <div class="card-conteudo">
          <p class="numero">01</p>
          <h3>Salão amplo com 7m² <br class="esconde-mobile">de pé direito</h3>
          <p class="desc-completa">Impacto visual e sensação<br>de amplitude que impressionam<br>logo na chegada, perfeito para cenografias imersivas, ativações<br>de marca ou montagens especiais.</p>
          <p class="desc-resumo">Amplo e imponente, ideal para cenografias imersivas e ativações de marca.</p>
        </div>
      </article>
      <article class="card">
        <Img src="estrutura-mezanino.jpg" alt="Mezanino do Leopoldo House com sala de apoio" width={700} style="width:100%;aspect-ratio:4/5;object-fit:cover" />
        <div class="card-conteudo">
          <p class="numero">02</p>
          <h3>Mezanino</h3>
          <p class="desc-completa">Espaço exclusivo com banheiro privativo, ideal para sala de apoio, reuniões paralelas ou uso executivo durante o evento.</p>
          <p class="desc-resumo">Espaço exclusivo com banheiro privativo, ideal para reuniões e uso executivo.</p>
        </div>
      </article>
      <article class="card">
        <Img src="estrutura-rooftop.jpg" alt="Rooftop garden com teto de vidro do Leopoldo House" width={700} style="width:100%;aspect-ratio:4/5;object-fit:cover" />
        <div class="card-conteudo">
          <p class="numero">03</p>
          <h3>Rooftop Garden</h3>
          <p class="desc-completa">Com teto de vidro, é o cenário ideal para eventos diurnos, brunchs corporativos ou sessões de integração ao pôr do sol.</p>
          <p class="desc-resumo">Teto de vidro, perfeito para eventos diurnos e brunchs corporativos.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- GASTRONOMIA -->
<section id="gastronomia">
  <div class="wrap">
    <div class="cabecalho-secao">
      <p class="rotulo">Gastronomia</p>
      <h2><span class="peso-book">A gastronomia também<br class="quebra-mobile"> faz parte da</span><span class="peso-bold">experiência da<br class="quebra-mobile"> sua marca.</span></h2>
      <p class="subtexto">Menus personalizados<br class="quebra-mobile"> e apresentações impecáveis<br class="quebra-mobile"> para surpreender convidados<br class="quebra-mobile"> e valorizar cada encontro.</p>
    </div>

    <div class="grid-gastro">
      <div class="item-gastro">
        <Img src="gastronomia-coffee-break.jpg" alt="Coffee break servido no Leopoldo House" width={600} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
        <h3>Coffee Break</h3>
      </div>
      <div class="item-gastro">
        <Img src="gastronomia-almoco-jantar.jpg" alt="Almoço e jantar executivo servido no Leopoldo House" width={600} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
        <h3>Almoço e Jantar Executivo</h3>
      </div>
      <div class="item-gastro">
        <Img src="gastronomia-ilhas.jpg" alt="Ilhas gastronômicas do Leopoldo House" width={600} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
        <h3>Ilhas Gastronômicas</h3>
      </div>
      <div class="item-gastro">
        <Img src="gastronomia-coquetel-volante.jpg" alt="Coquetel volante servido no Leopoldo House" width={600} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
        <h3>Coquetel Volante</h3>
      </div>
    </div>
  </div>
</section>

<!-- CONFIANÇA -->
<section id="confianca">
  <div class="wrap">
    <div class="cabecalho-secao">
      <p class="rotulo">Confiança</p>
      <h2><span class="peso-bold">Empresas<br class="quebra-mobile"> que confiaram</span><br><span class="peso-book">em nosso espaço<br class="quebra-mobile"> de eventos.</span></h2>
      <p class="subtexto">Conheça o Leopoldo House e viva uma experiência de sucesso.</p>
    </div>

    <div class="logos-track-wrap" aria-label="Empresas parceiras" role="region">
      <div class="logos-track">
        <div class="logos-inner">
          <div class="logo-item"><Img src="logo-empresa-01-chinalink.png" alt="ChinaLink" width={180} /></div>
          <div class="logo-item"><Img src="logo-empresa-02-snd.png" alt="SND" width={180} /></div>
          <div class="logo-item"><Img src="logo-empresa-03-all-accor.png" alt="All - Accor Live Limitless" width={180} /></div>
          <div class="logo-item"><Img src="logo-empresa-04-liberty-mutual.png" alt="Liberty Mutual" width={180} /></div>
          <div class="logo-item"><Img src="logo-empresa-05-turbi.png" alt="turbi" width={180} /></div>
          <!-- duplicado para loop contínuo -->
          <div class="logo-item" aria-hidden="true"><Img src="logo-empresa-01-chinalink.png" alt="" width={180} /></div>
          <div class="logo-item" aria-hidden="true"><Img src="logo-empresa-02-snd.png" alt="" width={180} /></div>
          <div class="logo-item" aria-hidden="true"><Img src="logo-empresa-03-all-accor.png" alt="" width={180} /></div>
          <div class="logo-item" aria-hidden="true"><Img src="logo-empresa-04-liberty-mutual.png" alt="" width={180} /></div>
          <div class="logo-item" aria-hidden="true"><Img src="logo-empresa-05-turbi.png" alt="" width={180} /></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CONTATO -->
<section id="contato">
  <div class="wrap grid-contato">
    <div>
      <p class="rotulo">Contato</p>
      <h2><span class="peso-book">Vamos começar</span><br><span class="peso-book">a planejar seu </span><br class="esconde-mobile"><span class="peso-bold">evento corporativo?</span></h2>
      <p class="subtexto-contato">Preencha o formulário para<br class="quebra-mobile"> receber nosso contato.</p>
    </div>

    <form
      class="form-contato"
      data-form-id="lead-form-v2-corporativo"
      data-project={projectSlug}
      data-submit-url={webhookUrl}
      data-success-id="form-success-corporativo"
    >
      <!-- Honeypot anti-spam -->
      <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" />

      <div class="campo-full">
        <label for="form-field-empresa">Nome da empresa</label>
        <input type="text" id="form-field-empresa" name="empresa" placeholder="Nome da sua empresa" required>
      </div>

      <div class="campo-full">
        <label for="form-field-nome">Nome</label>
        <input type="text" id="form-field-nome" name="nome" placeholder="Seu nome completo" required autocomplete="name">
      </div>

      <div>
        <label for="form-field-telefone">Telefone</label>
        <input type="tel" id="form-field-telefone" name="telefone" placeholder="(11) 90000-0000" required autocomplete="tel">
      </div>
      <div>
        <label for="form-field-email">E-mail</label>
        <input type="email" id="form-field-email" name="email" placeholder="seu@email.com" required autocomplete="email">
      </div>

      <div>
        <label for="form-field-tipo_evento">Tipo de evento</label>
        <select id="form-field-tipo_evento" name="tipo_evento" required>
          <option value="" selected disabled>Selecione</option>
          <option value="Coquetel">Coquetel</option>
          <option value="Jantar">Jantar</option>
          <option value="Plenária">Plenária</option>
          <option value="Workshop">Workshop</option>
          <option value="Convenção">Convenção</option>
          <option value="Treinamento">Treinamento</option>
          <option value="Confraternização">Confraternização</option>
          <option value="Outro">Outro</option>
        </select>
      </div>
      <div>
        <label for="form-field-data_evento">Data do evento</label>
        <input type="date" id="form-field-data_evento" name="data_evento" required>
      </div>

      <div class="campo-full">
        <label for="form-field-convidados">Número de convidados</label>
        <input type="number" id="form-field-convidados" name="convidados" min="1" placeholder="Ex: 150" required>
      </div>

      <div class="campo-full">
        <label for="form-field-detalhes_adicionais">Detalhes do evento (não obrigatório)</label>
        <textarea id="form-field-detalhes_adicionais" name="detalhes_adicionais" placeholder="Conte um pouco mais sobre o evento que você imagina"></textarea>
      </div>

      <div class="form-rodape">
        <p class="aviso-privacidade">Ao enviar, você concorda com nossa política de privacidade (LGPD).</p>
        <button type="button" class="btn btn-claro form-submit">Enviar solicitação →</button>
      </div>
    </form>

    <div id="form-success-corporativo" style="display:none;color:var(--cor-branco);padding:2rem;text-align:center;">
      <h3 style="font-size:1.4rem;margin-bottom:12px;">Solicitação enviada!</h3>
      <p>Obrigado. Em breve entraremos em contato.</p>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="wrap">
    <p>Copyright &copy; 2026 Leopoldo House - Todos os direitos reservados</p>
    <a href="#topo" class="logo">Leopoldo House</a>
    <p>Desenvolvido por <a href="https://dmove.com.br" target="_blank" rel="noopener">Dmove</a></p>
  </div>
</footer>

<!-- WhatsApp Widget (novo padrão) -->
<WhatsAppWidget
  phone={waPhone}
  submitUrl={webhookUrl}
  project={projectSlug}
  showEmpresaField={true}
/>

<!-- Gatilho de interação para Pixel/CAPI -->
<InteractionTrigger />

</Base>

<script>
  import '../scripts/eventos-corporativos-v2.js';
</script>
<script>
  import { initForms } from '../scripts/forms.ts';
  initForms();
</script>
