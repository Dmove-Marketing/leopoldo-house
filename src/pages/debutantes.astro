---
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import LeadForm from '../components/forms/LeadForm.astro';
import WhatsAppPopup from '../components/WhatsAppPopup.astro';
import Img from '../components/ui/Img.astro';
import '../styles/debutantes.css';
---

<Base
  title="Leopoldo House — Festa de 15 Anos no Itaim Bibi"
  description="Realize a festa de debutante dos seus sonhos no Itaim Bibi, São Paulo. Sofisticação, estrutura e alta gastronomia para uma noite inesquecível."
  ogImage="/images/og-debutantes.jpg"
>
<!-- ════════════ HERO ════════════ -->
<section class="hero" id="top">
  <Img src="hero-atual-debutante.png" alt="Salão do Leopoldo House decorado para festa de debutante" priority width={1920} class="hero-bg" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1" />
  <div class="hero-overlay"></div>
  <div class="hero-inner wrap">
    <Img src="logo-leopoldo.png" alt="Leopoldo House" class="hero-logo" width={280} priority />
    <h1 class="display"><span class="hero-light">A festa que você vai lembrar para<br>sempre começa aqui.<br>No Leopoldo House, cada detalhe é<br>pensado para transformar</span><br>sua celebração em uma noite única.</h1>
    <p class="lede">O novo endereço das festas de debutante em São Paulo.<br>
Itaim Bibi • Gastronomia premium • Produção completa</p>
    <div class="actions">
      <a href="#contato" class="btn btn-primary">Solicite um orçamento</a>
    </div>
  </div>
</section>

<!-- ════════════ SOBRE ════════════ -->
<section class="about" id="sobre">
  <div class="wrap">
    <div class="about-split reveal">
      <div class="about-split__text">
        <span class="eyebrow">O ESPAÇO</span>
        <h2 class="h2"><span class="hero-light">Para debutantes<br></span>que sabem o que querem.</h2>
        <p class="lede">Localizado em um dos endereços mais privilegiados de São Paulo, o Leopoldo House foi criado para receber festas de 15 anos inesquecíveis. Com ambientes sofisticados e serviços exclusivos, proporcionamos uma experiência completa para que cada detalhe aconteça exatamente como foi imaginado.</p>
      </div>
      <div class="about-split__video">
        <Img src="sobre-debutantes-principal.jpg" alt="Festa de debutante no Leopoldo House" width={800} style="width:100%;height:100%;object-fit:cover;border-radius:4px" />
      </div>
    </div>
  </div>
</section>


<!-- ════════════ ESTRUTURA ════════════ -->
<section class="structure" id="estrutura">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow center">ESTRUTURA</span>
      <h2 class="h2"><span class="hero-light">O cenário perfeito para <br></span>celebrar um dos momentos mais especiais da sua vida.</h2>
      <p class="lede">Um espaço onde cada abraço, cada dança <br class="mob-br" />e cada sorriso se transformam <br class="mob-br" />em memórias que atravessam gerações.</p>
    </div>

    <div class="amb reveal">
      <div class="amb-media"><Img src="salao-debutantes.jpg" alt="Salão principal do Leopoldo House com pé-direito de 7 metros" width={900} style="width:100%;height:100%;object-fit:cover;border-radius:inherit" /></div>
      <div class="amb-text">
        <span class="amb-num">01</span>
        <h3 class="h3">Salão amplo com 7m de pé-direito</h3>
        <p>Um espaço versátil para realizar a valsa, aproveitar a pista de dança e celebrar ao lado de amigos e familiares.</p>
      </div>
    </div>

    <div class="amb reveal">
      <div class="amb-media"><Img src="mezanino-00.jpg" alt="Mezanino do Leopoldo House" width={900} style="width:100%;height:100%;object-fit:cover;border-radius:inherit" /></div>
      <div class="amb-text">
        <span class="amb-num">02</span>
        <h3 class="h3">Suite da debutante</h3>
        <p>Ambiente reservado para se arrumar, fazer o making of e ter mais privacidade antes e durante a festa.</p>
      </div>
    </div>

    <div class="amb reveal">
      <div class="amb-media"><Img src="rooftop.jpg" alt="Rooftop Garden do Leopoldo House com teto de vidro" width={900} style="width:100%;height:100%;object-fit:cover;border-radius:inherit" /></div>
      <div class="amb-text">
        <span class="amb-num">03</span>
        <h3 class="h3">Rooftop Garden</h3>
        <p>Espaço que funciona como apoio à celebração, oferecendo um ambiente leve e descontraído para os convidados.</p>
      </div>
    </div>
  </div>
</section>

<!-- ════════════ GASTRONOMIA ════════════ -->
<section class="gastro" id="gastronomia">
  <div class="gastro-bg-slideshow">
    <div class="gastro-slide is-active"><Img src="gastro-coffee-break.webp" alt="Gastronomia - Coffee Break" width={1200} /></div>
    <div class="gastro-slide"><Img src="gastro-almoco-jantar.jpg" alt="Gastronomia - Almoço e Jantar" width={1200} /></div>
    <div class="gastro-slide"><Img src="gastro-ilhas.png" alt="Gastronomia - Ilhas Gastronômicas" width={1200} /></div>
    <div class="gastro-slide"><Img src="gastro-coquetel-volante.jpg" alt="Gastronomia - Coquetel" width={1200} /></div>
  </div>
  <div class="gastro-veil"></div>
  <div class="wrap">
    <div class="gastro-inner reveal">
      <span class="eyebrow center light">GASTRONOMIA</span>
      <h2 class="h2"><span class="hero-light">Gastronomia à altura <br></span>da sua celebração.</h2>
      <p class="lede">Uma experiência criada para surpreender convidados e tornar cada momento ainda mais memorável.</p>
    </div>
  </div>
</section>

<!-- ════════════ GALERIA ════════════ -->
<section class="gallery" id="galeria">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow center">GALERIA</span>
      <h2 class="h2"><span class="hero-light">Detalhes pensados<br></span>para valorizar a sua noite.</h2>
      <p class="lede">Conheça o Leopoldo House.</p>
    </div>
    <div class="gallery-carousel reveal">
      <div class="gallery-track">
        <div class="gallery-inner">
          <div class="gallery-slide"><Img src="galeria-deb-1.jpg" alt="Leopoldo House — festa de debutante" width={900} /></div>
          <div class="gallery-slide"><Img src="galeria-deb-2.jpg" alt="Leopoldo House — decoração debutante" width={900} /></div>
          <div class="gallery-slide"><Img src="galeria-deb-nova.png" alt="Leopoldo House — detalhes da festa" width={900} /></div>
          <div class="gallery-slide"><Img src="galeria-deb-5.png" alt="Leopoldo House — celebração" width={900} /></div>
          <div class="gallery-slide"><Img src="galeria-deb-6.png" alt="Leopoldo House — espaço decorado" width={900} /></div>
          <!-- duplicado para loop contínuo -->
          <div class="gallery-slide" aria-hidden="true"><Img src="galeria-deb-1.jpg" alt="" width={900} /></div>
          <div class="gallery-slide" aria-hidden="true"><Img src="galeria-deb-2.jpg" alt="" width={900} /></div>
          <div class="gallery-slide" aria-hidden="true"><Img src="galeria-deb-nova.png" alt="" width={900} /></div>
          <div class="gallery-slide" aria-hidden="true"><Img src="galeria-deb-5.png" alt="" width={900} /></div>
          <div class="gallery-slide" aria-hidden="true"><Img src="galeria-deb-6.png" alt="" width={900} /></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════════════ CONTATO ════════════ -->
<section class="contact" id="contato">
  <div class="wrap">
    <div class="section-head light reveal">
      <span class="eyebrow center light">CONTATO</span>
      <h2 class="h2"><span class="hero-light">Pronta para ser a debutante <br></span>mais comentada do ano?</h2>
      <p class="lede">Preencha o formulário para receber nosso contato.</p>
    </div>

    <div class="form reveal">
      <LeadForm
        showPrivacyNote={false}
        formId="debutantes-form"
        project={config.project_slug}
        submitUrl={config.forms['debutantes-form'].webhooks[0]}
        redirectUrl={config.forms['debutantes-form'].redirect_on_success}
        submitText="Enviar solicitação →"
        honeypot
        successTitle="Solicitação enviada!"
        successText="Obrigado. Em breve entraremos em contato para planejar a festa."
        fields={[
          { name: 'nome',         type: 'text',     placeholder: 'Seu nome completo',       required: true,  full: true, autocomplete: 'name' },
          { type: 'row', fields: [
            { name: 'telefone',   type: 'tel',      placeholder: '(11) 90000-0000',         required: true,  mask: 'phone', autocomplete: 'tel' },
            { name: 'email',      type: 'email',    placeholder: 'seu@email.com',           required: true,  autocomplete: 'email' },
          ]},
          { type: 'row', fields: [
            { name: 'data',       type: 'date',     placeholder: 'Data da festa',           required: false },
            { name: 'pessoas',    type: 'number',   placeholder: 'Nº de convidados',        required: false, min: '1' },
          ]},
          { name: 'tipo', type: 'select', full: true, required: false, options: [
            { value: '',                         label: 'Tipo de evento',          disabled: true, selected: true },
            { value: 'Aniversário',              label: 'Aniversário' },
            { value: 'Aniversário debutante',    label: 'Aniversário debutante' },
            { value: 'Confraternização social',  label: 'Confraternização social' },
            { value: 'Outros',                   label: 'Outros' },
          ]},
          { name: 'detalhes', type: 'textarea', placeholder: 'Conte um pouco sobre como você imagina a festa.', required: false, full: true, rows: 4 },
        ]}
      />
      <p class="form-privacy-link">
        Ao enviar, você concorda com nossa <a href="https://www.gov.br/governodigital/pt-br/privacidade-e-seguranca/ppsi/modelo_ppdp.pdf" target="_blank" rel="noopener noreferrer">política de privacidade (LGPD)</a>.
      </p>
    </div>
  </div>
</section>

<!-- ════════════ RODAPÉ ════════════ -->
<footer>
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-logo">
        <Img src="logo-leopoldo.png" alt="Leopoldo House" width={200} />
        <Img src="logo-t.venues.webp" alt="T.Venues" width={400} quality={100} />
      </div>
      <div class="foot-links">
        <div class="foot-col">
          <a href="#sobre">O Espaço</a>
          <a href="#estrutura">Estrutura</a>
        </div>
        <div class="foot-col">
          <a href="#gastronomia">Gastronomia</a>
          <a href="#contato">Solicitar orçamento</a>
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <span>Copyright © 2026 Leopoldo House - Todos os direitos reservados</span>
      <span class="foot-dev">Desenvolvido por <a href="https://dmove.com.br" target="_blank" rel="noopener"><Img src="logo-dmove.avif" alt="Dmove" width={72} /></a></span>
    </div>
  </div>
</footer>

<WhatsAppPopup
  formId="whats-popup-debutantes"
  project={config.project_slug}
  submitUrl={config.forms['debutantes-form'].webhooks[0]}
  redirectUrl={config.forms['debutantes-form'].redirect_on_success}
  greeting="Olá! Está planejando a festa de 15 anos perfeita? Preencha abaixo e nossa equipe entrará em contato para criar uma experiência inesquecível."
  dataPlaceholder="Data da festa"
  tipoOptions={[
    { value: '',                        label: 'Tipo de evento',          disabled: true, selected: true },
    { value: 'Aniversário',             label: 'Aniversário' },
    { value: 'Aniversário debutante',   label: 'Aniversário debutante' },
    { value: 'Confraternização social', label: 'Confraternização social' },
    { value: 'Outros',                  label: 'Outros' },
  ]}
/>

</Base>
<script>
  import '../scripts/debutantes.js';
</script>

<script>
  // Slideshow do background da seção Gastronomia
  const slides = document.querySelectorAll('.gastro-slide');
  if (slides.length > 0) {
    let currentSlide = 0;
    setInterval(() => {
      slides[currentSlide].classList.remove('is-active');
      currentSlide = (currentSlide + 1) % slides.length;
      slides[currentSlide].classList.add('is-active');
    }, 4500);
  }
</script>
