---
import 'flatpickr/dist/flatpickr.min.css';

interface TipoOption {
  value: string;
  label: string;
  disabled?: boolean;
  selected?: boolean;
}

interface Props {
  formId?: string;
  project: string;
  submitUrl: string;
  redirectUrl?: string;
  tipoOptions: TipoOption[];
  dataPlaceholder?: string;
  greeting?: string;
}

const {
  formId = 'whats-popup',
  project,
  submitUrl,
  redirectUrl = '',
  tipoOptions,
  dataPlaceholder = 'Data do evento',
  greeting = 'Olá! Gostaria de conhecer o Leopoldo House para o seu próximo evento? Preencha abaixo e nossa equipe entrará em contato pelo WhatsApp.',
} = Astro.props;
---

<div
  class="wa-widget"
  data-form-id={formId}
  data-project={project}
  data-submit-url={submitUrl}
  data-redirect={redirectUrl}
>
  <!-- FAB -->
  <button class="wa-fab" aria-label="Falar pelo WhatsApp">
    <svg class="wa-fab-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
    <span class="wa-fab-pulse" aria-hidden="true"></span>
  </button>

  <!-- Overlay -->
  <div class="wa-overlay" aria-hidden="true"></div>

  <!-- Popup -->
  <div
    class="wa-popup"
    role="dialog"
    aria-modal="true"
    aria-label="Formulário de contato"
    aria-hidden="true"
  >
    <!-- Header -->
    <div class="wa-header">
      <div class="wa-avatar" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="white" width="26" height="26">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </div>
      <div class="wa-header-info">
        <strong class="wa-contact-name">Leopoldo House</strong>
        <span class="wa-contact-status">
          <span class="wa-status-dot" aria-hidden="true"></span>Online agora
        </span>
      </div>
      <button class="wa-close-btn" aria-label="Fechar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Chat bubble -->
    <div class="wa-chat-body">
      <div class="wa-message">
        <p set:html={greeting}></p>
        <span class="wa-msg-time" aria-hidden="true">agora</span>
      </div>
    </div>

    <!-- Form + success -->
    <div class="wa-form-wrap">
      <form class="wa-form" novalidate>
        <!-- Honeypot -->
        <div class="wa-hp" aria-hidden="true">
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <!-- Step 1 -->
        <div class="wa-step is-active" data-step="1">
          <div class="wa-progress"><div class="wa-bar" style="width:50%"></div></div>
          <p class="wa-step-lbl">Etapa 1 de 2 — Seus dados</p>

          <div class="wa-field">
            <input class="wa-input" type="text" name="nome" placeholder="Seu nome completo" required autocomplete="name" />
          </div>
          <div class="wa-field">
            <input class="wa-input" type="tel" name="telefone" placeholder="(11) 90000-0000" required autocomplete="tel" data-mask="phone" />
          </div>
          <div class="wa-field">
            <input class="wa-input" type="email" name="email" placeholder="seu@email.com" required autocomplete="email" />
          </div>

          <p class="wa-err" role="alert" aria-live="polite"></p>

          <button type="button" class="wa-btn wa-btn-green wa-next-btn">
            Próximo
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="15" height="15" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </div>

        <!-- Step 2 -->
        <div class="wa-step" data-step="2">
          <div class="wa-progress"><div class="wa-bar" style="width:100%"></div></div>
          <p class="wa-step-lbl">Etapa 2 de 2 — Seu evento</p>

          <div class="wa-field">
            <select class="wa-select" name="tipo" required>
              {tipoOptions.map(opt => (
                <option value={opt.value} disabled={opt.disabled} selected={opt.selected}>{opt.label}</option>
              ))}
            </select>
          </div>

          <div class="wa-row">
            <div class="wa-field">
              <input class="wa-input" type="text" name="data" placeholder={dataPlaceholder} readonly data-wa-datepicker autocomplete="off" required />
            </div>
            <div class="wa-field">
              <input class="wa-input" type="number" name="pessoas" placeholder="Convidados" min="1" required />
            </div>
          </div>

          <p class="wa-err" role="alert" aria-live="polite"></p>

          <div class="wa-s2-actions">
            <button type="button" class="wa-btn wa-btn-ghost wa-back-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="15" height="15" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              Voltar
            </button>
            <button type="submit" class="wa-btn wa-btn-green wa-submit-btn">
              <span class="wa-btn-text">Enviar</span>
              <span class="wa-btn-spin" aria-hidden="true">
                <svg class="wa-spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15">
                  <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
                </svg>
                Enviando...
              </span>
            </button>
          </div>

          <p class="wa-privacy">Ao enviar, você concorda com nossa política de privacidade.</p>
        </div>
      </form>

      <!-- Success -->
      <div class="wa-success" hidden>
        <div class="wa-success-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" width="32" height="32">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <h3 class="wa-success-title">Mensagem enviada!</h3>
        <p class="wa-success-text">Obrigado. Em breve nossa equipe entrará em contato pelo WhatsApp ou e-mail.</p>
      </div>
    </div>
  </div>
</div>

<script>
  import flatpickr from 'flatpickr';
  import { Portuguese } from 'flatpickr/dist/l10n/pt.js';

  flatpickr.localize(Portuguese);

  document.querySelectorAll<HTMLElement>('.wa-widget').forEach(widget => {
    const submitUrl = widget.dataset.submitUrl ?? '';
    const project   = widget.dataset.project   ?? '';
    const formId    = widget.dataset.formId    ?? 'whats-popup';
    const redirect  = widget.dataset.redirect  ?? '';

    const fab       = widget.querySelector<HTMLButtonElement>('.wa-fab')!;
    const overlay   = widget.querySelector<HTMLElement>('.wa-overlay')!;
    const popup     = widget.querySelector<HTMLElement>('.wa-popup')!;
    const closeBtn  = widget.querySelector<HTMLButtonElement>('.wa-close-btn')!;
    const form      = widget.querySelector<HTMLFormElement>('.wa-form')!;
    const steps     = Array.from(widget.querySelectorAll<HTMLElement>('.wa-step'));
    const nextBtn   = widget.querySelector<HTMLButtonElement>('.wa-next-btn')!;
    const backBtn   = widget.querySelector<HTMLButtonElement>('.wa-back-btn')!;
    const submitBtn = widget.querySelector<HTMLButtonElement>('.wa-submit-btn')!;
    const successEl = widget.querySelector<HTMLElement>('.wa-success')!;

    // Phone mask
    const telInput = form.querySelector<HTMLInputElement>('[name="telefone"]')!;
    telInput.addEventListener('input', () => {
      let v = telInput.value.replace(/\D/g, '').slice(0, 11);
      if (v.length > 10)     v = v.replace(/^(\d{2})(\d{5})(\d{4}).*/, '($1) $2-$3');
      else if (v.length > 6) v = v.replace(/^(\d{2})(\d{4})(\d*)/, '($1) $2-$3');
      else if (v.length > 2) v = v.replace(/^(\d{2})(\d*)/, '($1) $2');
      else if (v.length > 0) v = '(' + v;
      telInput.value = v;
    });

    // Flatpickr on popup's date input (separate attribute to avoid double-init with LeadForm)
    const dateEl = form.querySelector<HTMLInputElement>('[data-wa-datepicker]');
    if (dateEl) {
      flatpickr(dateEl, { dateFormat: 'd/m/Y', minDate: 'today', disableMobile: true });
    }

    // Toggle
    function isOpen() { return popup.getAttribute('aria-hidden') === 'false'; }

    function open() {
      popup.setAttribute('aria-hidden', 'false');
      overlay.classList.add('is-visible');
      fab.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      setTimeout(() => steps[0].querySelector<HTMLInputElement>('input')?.focus(), 250);
    }

    function close() {
      popup.setAttribute('aria-hidden', 'true');
      overlay.classList.remove('is-visible');
      fab.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    fab.addEventListener('click', (e) => { e.stopPropagation(); isOpen() ? close() : open(); });
    closeBtn.addEventListener('click', close);
    overlay.addEventListener('click', close);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen()) close(); });

    // Steps
    function goTo(n: number) {
      steps.forEach((s, i) => s.classList.toggle('is-active', i + 1 === n));
    }

    function errEl(stepIdx: number) {
      return steps[stepIdx].querySelector<HTMLElement>('.wa-err')!;
    }

    function showErr(stepIdx: number, msg: string) {
      const el = errEl(stepIdx);
      el.textContent = msg;
      el.classList.add('is-visible');
    }

    function clearErr(stepIdx: number) {
      const el = errEl(stepIdx);
      el.textContent = '';
      el.classList.remove('is-visible');
    }

    function validateStep1(): string | null {
      const nome  = form.querySelector<HTMLInputElement>('[name="nome"]')!.value.trim();
      const tel   = form.querySelector<HTMLInputElement>('[name="telefone"]')!.value.replace(/\D/g, '');
      const email = form.querySelector<HTMLInputElement>('[name="email"]')!.value.trim();
      if (!nome) return 'Por favor, informe seu nome.';
      if (tel.length < 10) return 'Informe um WhatsApp válido com DDD.';
      if (!email.includes('@') || !email.split('@')[1]?.includes('.')) return 'Informe um e-mail válido.';
      return null;
    }

    nextBtn.addEventListener('click', () => {
      const err = validateStep1();
      if (err) { showErr(0, err); return; }
      clearErr(0);
      goTo(2);
    });

    backBtn.addEventListener('click', () => { clearErr(1); goTo(1); });

    function validateStep2(): string | null {
      const tipo    = form.querySelector<HTMLSelectElement>('[name="tipo"]')!.value;
      const data    = form.querySelector<HTMLInputElement>('[name="data"]')!.value.trim();
      const pessoas = form.querySelector<HTMLInputElement>('[name="pessoas"]')!.value.trim();
      if (!tipo)    return 'Selecione o tipo de evento.';
      if (!data)    return 'Informe a data do evento.';
      if (!pessoas) return 'Informe o número de convidados.';
      return null;
    }

    // Submit
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const hp = form.querySelector<HTMLInputElement>('[name="website"]');
      if (hp?.value) return;

      const err2 = validateStep2();
      if (err2) { showErr(1, err2); return; }

      const btnText    = submitBtn.querySelector<HTMLElement>('.wa-btn-text')!;
      const btnSpin    = submitBtn.querySelector<HTMLElement>('.wa-btn-spin')!;

      submitBtn.disabled = true;
      btnText.style.display = 'none';
      btnSpin.style.display = 'inline-flex';
      clearErr(1);

      try {
        const trackingRaw = sessionStorage.getItem('dmove_tracking');
        const tracking    = trackingRaw ? JSON.parse(trackingRaw) : {};

        let fonte = tracking.landing_page || window.location.pathname;
        if (tracking.utm_source) {
          fonte = tracking.utm_source;
          if (tracking.utm_medium) fonte += ` / ${tracking.utm_medium}`;
        }

        const now = new Date();
        const dateFmt = now.toLocaleDateString('pt-BR');
        const timeFmt = now.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', hour12: false });

        const payload: Record<string, string> = {
          'Nome':           form.querySelector<HTMLInputElement>('[name="nome"]')?.value.trim() || '',
          'WhatsApp':       form.querySelector<HTMLInputElement>('[name="telefone"]')?.value.trim() || '',
          'E-mail':         form.querySelector<HTMLInputElement>('[name="email"]')?.value.trim() || '',
          'Tipo de evento': form.querySelector<HTMLSelectElement>('[name="tipo"]')?.value || '',
          'Data do evento': form.querySelector<HTMLInputElement>('[name="data"]')?.value || '',
          'Convidados':     form.querySelector<HTMLInputElement>('[name="pessoas"]')?.value || '',
          'Mensagem':       form.querySelector<HTMLTextAreaElement>('[name="detalhes"]')?.value.trim() || '',
          'Fonte':          fonte,
          'Date':           dateFmt,
          'Time':           timeFmt,
          'Page URL':       window.location.href,
          'User Agent':     navigator.userAgent,
          'Remote IP':      '',
          'Powered by':     'Dmove',
          'form_id':        formId,
          'form_name':      formId,
        };

        const res = await fetch(submitUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(payload).toString(),
        });
        if (!res.ok) throw new Error();

        form.hidden = true;
        successEl.hidden = false;
        if (redirect) setTimeout(() => { window.location.href = redirect; }, 3000);
      } catch {
        showErr(1, 'Erro ao enviar. Tente novamente.');
        submitBtn.disabled = false;
        btnText.style.display = '';
        btnSpin.style.display = 'none';
      }
    });
  });
</script>

<style>
  /* ── Overlay ── */
  .wa-overlay {
    position: fixed;
    inset: 0;
    z-index: 9996;
    background: rgba(0, 0, 0, 0);
    pointer-events: none;
    transition: background .3s ease;
  }
  .wa-overlay.is-visible {
    background: rgba(0, 0, 0, .55);
    pointer-events: all;
  }

  /* ── FAB ── */
  .wa-fab {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9998;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #25D366;
    color: #fff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(37,211,102,.45);
    transition: transform .2s ease, background .2s ease, box-shadow .2s ease;
  }
  .wa-fab:hover { transform: scale(1.08); box-shadow: 0 6px 28px rgba(37,211,102,.55); }
  .wa-fab.is-open { background: #128C7E; box-shadow: 0 4px 20px rgba(18,140,126,.4); }
  .wa-fab-icon { width: 32px; height: 32px; flex-shrink: 0; }

  .wa-fab-pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(37,211,102,.35);
    animation: wa-pulse 2.2s ease-out infinite;
    pointer-events: none;
  }
  .wa-fab.is-open .wa-fab-pulse { display: none; }

  @keyframes wa-pulse {
    0%   { transform: scale(1);   opacity: .8; }
    70%  { transform: scale(1.6); opacity: 0;  }
    100% { transform: scale(1.6); opacity: 0;  }
  }

  /* ── Popup ── */
  .wa-popup {
    position: fixed;
    bottom: 100px;
    right: 24px;
    z-index: 9997;
    width: 370px;
    max-height: calc(100dvh - 140px);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: #fff;
    box-shadow: 0 16px 56px rgba(0,0,0,.22), 0 2px 8px rgba(0,0,0,.08);
    transform-origin: bottom right;
    /* closed state */
    opacity: 0;
    transform: scale(.88) translateY(10px);
    visibility: hidden;
    pointer-events: none;
    transition: opacity .25s ease, transform .25s ease, visibility 0s .25s;
  }
  .wa-popup[aria-hidden="false"] {
    opacity: 1;
    transform: scale(1) translateY(0);
    visibility: visible;
    pointer-events: all;
    transition: opacity .25s ease, transform .25s ease, visibility 0s 0s;
  }

  /* ── Header ── */
  .wa-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 14px 14px 16px;
    background: #075E54;
    flex-shrink: 0;
  }
  .wa-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #128C7E;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .wa-header-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .wa-contact-name {
    font-family: var(--font-display, sans-serif);
    font-size: 15px;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .wa-contact-status {
    font-size: 12px;
    color: rgba(255,255,255,.78);
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .wa-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #25D366;
    flex-shrink: 0;
  }
  .wa-close-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: rgba(255,255,255,.75);
    padding: 6px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background .15s, color .15s;
    flex-shrink: 0;
  }
  .wa-close-btn:hover { background: rgba(255,255,255,.12); color: #fff; }

  /* ── Chat bubble ── */
  .wa-chat-body {
    padding: 16px 14px 14px;
    background: #ECE5DD;
    flex-shrink: 0;
  }
  .wa-message {
    position: relative;
    background: #fff;
    border-radius: 0 10px 10px 10px;
    padding: 10px 12px 20px;
    max-width: 92%;
    box-shadow: 0 1px 3px rgba(0,0,0,.1);
  }
  .wa-message::before {
    content: '';
    position: absolute;
    top: 0;
    left: -8px;
    border-style: solid;
    border-width: 0 8px 8px 0;
    border-color: transparent #fff transparent transparent;
  }
  .wa-message p {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--brown, #54362C);
  }
  .wa-msg-time {
    position: absolute;
    bottom: 5px;
    right: 10px;
    font-size: 10px;
    color: rgba(84,54,44,.45);
  }

  /* ── Form wrap ── */
  .wa-form-wrap {
    padding: 16px;
    overflow-y: auto;
    flex: 1;
    min-height: 0;
    background: var(--ivory, #FBF6EA);
  }
  .wa-form-wrap::-webkit-scrollbar { width: 4px; }
  .wa-form-wrap::-webkit-scrollbar-thumb { background: var(--line, rgba(84,54,44,.2)); border-radius: 4px; }

  /* ── Steps ── */
  .wa-step { display: none; }
  .wa-step.is-active { display: block; }

  /* ── Progress ── */
  .wa-progress {
    height: 3px;
    background: rgba(84,54,44,.12);
    border-radius: 3px;
    margin-bottom: 10px;
    overflow: hidden;
  }
  .wa-bar {
    height: 100%;
    background: #25D366;
    border-radius: 3px;
    transition: width .35s ease;
  }
  .wa-step-lbl {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .06em;
